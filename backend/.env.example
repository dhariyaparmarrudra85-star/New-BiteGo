# ==========================================
# BiteGo Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# DO NOT commit real secrets or credentials to version control.
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/BiteGo?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# SuperAdmin Initial Seed (Optional)
SUPERADMIN_EMAIL=superadmin@bitego.com
SUPERADMIN_PASSWORD=your_superadmin_password_here

# SMS Services (Optional for dev, required for production phone login)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
MSG91_AUTH_KEY=your_msg91_auth_key_here
