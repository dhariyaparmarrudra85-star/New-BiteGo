# ==========================================
# BiteGo Root .gitignore
# Environment variables and secrets
# ==========================================
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!.env.*.example
!backend/.env.example
!frontend/.env.example

# ==========================================
# Dependencies
# ==========================================
node_modules/
**/node_modules/

# ==========================================
# Build outputs
# ==========================================
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
.next/
.output/

# ==========================================
# Database backups, dumps, and local data
# ==========================================
backups/
**/backups/
*.ejson
*.bson
*.sqlite
*.sqlite3
*.db
mongodb-data/
data/db/

# ==========================================
# Uploads and temporary media
# ==========================================
uploads/
**/uploads/*
!**/uploads/.gitkeep
storage/
temp/
tmp/
.tmp/

# ==========================================
# Logs and debug output
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Cache and framework artifacts
# ==========================================
.cache/
**/.cache/
.vite/
**/.vite/
vite.config.*.timestamp-*
*.local

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/
playwright-report/
test-results/

# ==========================================
# IDE and OS files
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
